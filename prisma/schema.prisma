generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ProposalResponse {
  id         String   @id @default(uuid())
  accepted   Boolean  @default(true)
  acceptedAt DateTime @default(now())
}
